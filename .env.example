# --- Telegram ---
BOT_TOKEN=
# MTProto API credentials (https://my.telegram.org -> API development tools).
# Required even for bot-token auth — Telegram needs them for authorization.
API_ID=
API_HASH=
# Bot must be admin (or at least member) in every source channel it indexes.
ADMIN_USER_IDS=123456789
# Optional: OpenRouter API key — AI fallback that identifies messy release
# filenames when TMDB can't match them (e.g. transliterations, mangled names).
# Only used for titles TMDB rejects; every guess is cross-checked on TMDB.
# OPENROUTER_API_KEY=
# Default is the free-tier-friendly model below. Use openai/gpt-4o-mini
# only if your key has paid credits.
# LLM_MODEL=liquid/lfm-2.5-2.6b:free

# No session string needed: history is read with the bot token via
# messages.GetMessages (explicit ID ranges). The bot must be admin in
# private source channels.

# --- TMDB (server-side only, never exposed to the Mini App) ---
TMDB_API_KEY=

# --- App ---
# Public URL of the Mini App, e.g. https://media.example.com/app/
MINI_APP_URL=http://localhost:8000/app/
DATABASE_PATH=/app/data/catalog.db
PORT=8000
LOG_LEVEL=INFO
