# --- Telegram ---
BOT_TOKEN=
# MTProto API credentials (https://my.telegram.org -> API development tools).
# Required even for bot-token auth — Telegram needs them for authorization.
API_ID=
API_HASH=
# Bot must be admin (or at least member) in every source channel it indexes.
ADMIN_USER_IDS=123456789
# Optional: OpenRouter API key — AI fallback that identifies messy release
# filenames when TMDB can't match them (e.g. transliterations, mangled names).
# Only used for titles TMDB rejects; every guess is cross-checked on TMDB.
# OPENROUTER_API_KEY=
# Default is the free-tier-friendly model below. Use openai/gpt-4o-mini
# only if your key has paid credits.
# LLM_MODEL=liquid/lfm-2.5-2.6b:free

# No session string needed: history is read with the bot token via
# messages.GetMessages (explicit ID ranges). The bot must be admin in
# private source channels.

# --- TMDB (server-side only, never exposed to the Mini App) ---
TMDB_API_KEY=

# Optional: MN IMDb poster fallback — fills posters for titles TMDB
# cannot match (poster only; titles stay unmatched, nothing is merged).
# Free API, no key. Set MN_IMDB_BASE_URL= (empty) to disable.
# MN_IMDB_BASE_URL=https://mn-api-imdb.vercel.app

# --- App ---
# Public URL of the Mini App, e.g. https://media.example.com/app/
MINI_APP_URL=http://localhost:8000/app/
DATABASE_PATH=/app/data/catalog.db
PORT=8000
LOG_LEVEL=INFO
# Optional signing secret for Mini App stream URLs. When empty, a stable
# value is derived from BOT_TOKEN server-side; set one explicitly if the
# bot token ever rotates and old stream links must keep working.
# STREAM_SECRET=

# --- Owner features ---
# Bot owner ids (ADMIN_USER_IDS) get Settings, /users, /broadcast, and all
# owner-only commands. SUDO_USER_IDS get operational commands only:
# /index, /indexstatus, /stopindex, /addchannel, /channels, /setskip, /stats.
# Sudo users NEVER get Settings, /users, /broadcast, /rmchannel, /cleanup,
# /reparse, start-photo, force-subscribe, or live-logs changes.
# SUDO_USER_IDS=111111111,222222222
# Live logs channel (-100 id, bot must be admin there, keep it private).
# When empty, live logs are off unless set in the Settings menu (which wins).
# LOG_CHANNEL_ID=-1000000000000
