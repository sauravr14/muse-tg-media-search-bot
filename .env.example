# --- Telegram ---
BOT_TOKEN=
# MTProto API credentials (https://my.telegram.org -> API development tools).
# Required even for bot-token auth — Telegram needs them for authorization.
API_ID=
API_HASH=
# Bot must be admin (or at least member) in every source channel it indexes.
ADMIN_USER_IDS=123456789
# Optional: user session string for *history* backfill. Bots cannot read channel
# history (Telegram platform limit); without this, only NEW posts are indexed.
# Generate with: python3 tools/make_session.py
# SESSION_STRING=

# --- TMDB (server-side only, never exposed to the Mini App) ---
TMDB_API_KEY=

# --- App ---
# Public URL of the Mini App, e.g. https://media.example.com/app/
MINI_APP_URL=http://localhost:8000/app/
DATABASE_PATH=/app/data/catalog.db
PORT=8000
LOG_LEVEL=INFO
